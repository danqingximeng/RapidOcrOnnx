#!/usr/bin/env python3
# Unified wrapper around RapidOcrOnnx: CLI mode and persistent HTTP server mode.
# Stdlib only (Python >= 3.11 for tomllib).

import argparse
import json
import mimetypes
import os
import select
import signal
import subprocess
import sys
import threading
import time
import tomllib
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from urllib.parse import unquote, urlsplit

SCRIPT_DIR = os.path.dirname(os.path.realpath(__file__))

DEFAULT_ENGINE_PATH = "/opt/RapidOcrOnnx/build/RapidOcrOnnx"
DEFAULT_MODELS_DIR = "/opt/RapidOcrOnnx/models"
DEFAULT_CLS = "ch_ppocr_mobile_v2.0_cls_infer.onnx"
DEFAULT_PRESET = "small"

BUILTIN_PRESETS = {
    "tiny": {"det": "PP-OCRv6_tiny_det.onnx", "rec": "PP-OCRv6_tiny_rec.onnx"},
    "small": {"det": "PP-OCRv6_small_det.onnx", "rec": "PP-OCRv6_small_rec.onnx"},
    "medium": {"det": "PP-OCRv6_medium_det.onnx", "rec": "PP-OCRv6_medium_rec.onnx"},
}

HANDSHAKE_TIMEOUT = 15.0
SERVE_READ_TIMEOUT = 120.0
MAX_REQUEST_BODY = 64 * 1024 * 1024

OVERRIDE_KEYS = (
    "maxSide", "minSide", "maxSideLimit", "upscale",
    "thresh", "boxThresh", "unclipRatio", "doAngle", "mostAngle",
)

ENGINE_FLAGS = (
    ("thread", "--thread"),
    ("max_side", "--max-side"),
    ("min_side", "--min-side"),
    ("max_side_limit", "--max-side-limit"),
    ("upscale", "--upscale"),
    ("thresh", "--thresh"),
    ("box_thresh", "--box-thresh"),
    ("unclip_ratio", "--unclip-ratio"),
    ("do_angle", "--do-angle"),
    ("most_angle", "--most-angle"),
    ("gpu", "--gpu"),
)

HTTP_STATUS_BY_CODE = {100: 200, 101: 200, 200: 400, 201: 500, 202: 400}


def dict_for_rec(rec_name):
    if "tiny" in rec_name:
        return "ppocrv6_tiny_dict.txt"
    if "v3" in rec_name:
        return "ppocr_keys_v1.txt"
    if "v5" in rec_name:
        return "ppocrv5_dict.txt"
    return "ppocrv6_dict.txt"


def sort_none(blocks):
    return blocks


SORTERS = {
    "none": sort_none,
}


class ConfigError(Exception):
    pass


class EngineError(Exception):
    pass


def load_config(path):
    cfg = {
        "default_preset": DEFAULT_PRESET,
        "engine": {"path": DEFAULT_ENGINE_PATH, "dir": DEFAULT_MODELS_DIR},
        "server": {"host": "0.0.0.0", "port": 1538, "web_root": os.path.join(SCRIPT_DIR, "web")},
        "presets": {},
    }
    if path is None:
        for candidate in (
            os.path.join(SCRIPT_DIR, "config.toml"),
            os.path.expanduser("~/.config/rapidocr/config.toml"),
        ):
            if os.path.isfile(candidate):
                path = candidate
                break
        else:
            return cfg
    try:
        with open(path, "rb") as f:
            data = tomllib.load(f)
    except (OSError, tomllib.TOMLDecodeError) as e:
        raise ConfigError(f"cannot load config {path}: {e}") from e

    unknown = set(data) - {"default_preset", "engine", "server", "presets"}
    if unknown:
        raise ConfigError(f"unknown config keys: {', '.join(sorted(unknown))}")

    if "default_preset" in data:
        if not isinstance(data["default_preset"], str):
            raise ConfigError("default_preset must be a string")
        cfg["default_preset"] = data["default_preset"]

    for section in ("engine", "server"):
        if section in data:
            if not isinstance(data[section], dict):
                raise ConfigError(f"[{section}] must be a table")
            cfg[section].update(data[section])
    for key in ("path", "dir"):
        if not isinstance(cfg["engine"].get(key), str):
            raise ConfigError(f"engine.{key} must be a string")
    if not isinstance(cfg["server"].get("host"), str):
        raise ConfigError("server.host must be a string")
    if not isinstance(cfg["server"].get("port"), int):
        raise ConfigError("server.port must be an integer")
    if cfg["server"].get("web_root") is not None and not isinstance(cfg["server"]["web_root"], str):
        raise ConfigError("server.web_root must be a string")

    if "presets" in data:
        if not isinstance(data["presets"], dict):
            raise ConfigError("[presets] must be a table of tables")
        for name, preset in data["presets"].items():
            if not isinstance(preset, dict):
                raise ConfigError(f"[presets.{name}] must be a table")
            unknown = set(preset) - {"det", "rec", "cls", "dict"}
            if unknown:
                raise ConfigError(f"unknown keys in [presets.{name}]: {', '.join(sorted(unknown))}")
            for required in ("det", "rec"):
                if not isinstance(preset.get(required), str):
                    raise ConfigError(f"presets.{name}.{required} must be a string")
            for optional in ("cls", "dict"):
                if optional in preset and not isinstance(preset[optional], str):
                    raise ConfigError(f"presets.{name}.{optional} must be a string")
        cfg["presets"].update(data["presets"])
    return cfg


def resolve_preset(cfg, name):
    name = name or cfg["default_preset"]
    presets = {**BUILTIN_PRESETS, **cfg["presets"]}
    if name not in presets:
        raise ConfigError(f"unknown preset '{name}' (available: {', '.join(sorted(presets))})")
    preset = dict(presets[name])
    preset.setdefault("cls", DEFAULT_CLS)
    preset.setdefault("dict", dict_for_rec(preset["rec"]))
    return preset


def flags_from_args(args):
    flags = []
    for attr, flag in ENGINE_FLAGS:
        value = getattr(args, attr, None)
        if value is not None:
            flags += [flag, str(value)]
    return flags


def check_model_files(models_dir, preset):
    missing = []
    for key in ("det", "cls", "rec", "dict"):
        path = os.path.join(models_dir, preset[key])
        if not os.path.isfile(path):
            missing.append(path)
    if missing:
        raise ConfigError("model file(s) not found:\n  " + "\n  ".join(missing))


class EngineClient:
    def __init__(self, argv_factory, preset, available, read_timeout=None):
        # argv_factory(name) -> engine argv; validates the preset and raises
        # ConfigError for unknown names or missing model files.
        self._argv_factory = argv_factory
        self._available = list(available)
        self._preset = preset
        self._argv = argv_factory(preset)
        self._read_timeout = read_timeout
        self._proc = None
        self._lock = threading.Lock()
        self._buf = b""

    @property
    def preset(self):
        return self._preset

    @property
    def available_presets(self):
        return list(self._available)

    def request(self, payload, model=None):
        with self._lock:
            if model is not None and model != self._preset:
                self._switch_preset(model)
            self._ensure_running()
            try:
                data = (json.dumps(payload, ensure_ascii=False) + "\n").encode("utf-8")
                self._proc.stdin.write(data)
                self._proc.stdin.flush()
                line = self._readline(self._read_timeout)
                if line is None:
                    raise EngineError("engine exited")
                return json.loads(line)
            except EngineError:
                self._stop()
                raise
            except (BrokenPipeError, OSError) as e:
                self._stop()
                raise EngineError(f"engine pipe error: {e}") from e
            except json.JSONDecodeError as e:
                self._stop()
                raise EngineError(f"invalid engine response: {e}") from e

    def start(self):
        with self._lock:
            self._ensure_running()

    def stop(self):
        with self._lock:
            self._stop()

    def _ensure_running(self):
        if self._proc is not None and self._proc.poll() is not None:
            self._stop()
        if self._proc is None:
            self._start()

    def _switch_preset(self, model):
        # caller holds the lock; validate before killing the current engine
        argv = self._argv_factory(model)
        self._stop()
        self._argv = argv
        self._preset = model

    def _start(self):
        self._buf = b""
        self._proc = subprocess.Popen(
            self._argv,
            stdin=subprocess.PIPE,
            stdout=subprocess.PIPE,
            stderr=None,
        )
        try:
            deadline = time.monotonic() + HANDSHAKE_TIMEOUT
            last = ""
            while True:
                remaining = deadline - time.monotonic()
                if remaining <= 0:
                    raise EngineError(f"engine init timeout ({HANDSHAKE_TIMEOUT:.0f}s)")
                line = self._readline(remaining)
                if line is None:
                    raise EngineError(f"engine exited during init: {last or 'no output'}")
                last = line
                if "OCR init completed." in line:
                    return
        except EngineError:
            self._stop()
            raise

    def _readline(self, timeout):
        # os.read + our own line buffer: mixing select() with a buffered
        # reader's readline() loses wakeups when readline() drains the OS
        # pipe into its internal buffer.
        deadline = None if timeout is None else time.monotonic() + timeout
        while True:
            newline = self._buf.find(b"\n")
            if newline >= 0:
                line, self._buf = self._buf[:newline], self._buf[newline + 1:]
                return line.decode("utf-8", errors="replace").rstrip("\r")
            remaining = None
            if deadline is not None:
                remaining = deadline - time.monotonic()
                if remaining <= 0:
                    raise EngineError(f"engine response timeout ({timeout:.0f}s)")
            ready, _, _ = select.select([self._proc.stdout], [], [], remaining)
            if not ready:
                raise EngineError(f"engine response timeout ({timeout:.0f}s)")
            chunk = os.read(self._proc.stdout.fileno(), 65536)
            if chunk == b"":
                if self._buf:
                    line, self._buf = self._buf, b""
                    return line.decode("utf-8", errors="replace").rstrip("\r")
                return None
            self._buf += chunk

    def _stop(self):
        if self._proc is not None:
            try:
                self._proc.kill()
                self._proc.wait(timeout=5)
            except (OSError, subprocess.TimeoutExpired):
                pass
            self._proc = None


def build_engine_argv(cfg, preset, extra_flags):
    return [
        cfg["engine"]["path"], "--server",
        "--dir", cfg["engine"]["dir"],
        "--det", preset["det"],
        "--cls", preset["cls"],
        "--rec", preset["rec"],
        "--key", preset["dict"],
        *extra_flags,
    ]


def make_client(cfg, args, read_timeout=None):
    flags = flags_from_args(args)
    presets = {**BUILTIN_PRESETS, **cfg["presets"]}
    initial = args.preset or cfg["default_preset"]

    def argv_factory(name):
        preset = resolve_preset(cfg, name)
        check_model_files(cfg["engine"]["dir"], preset)
        return build_engine_argv(cfg, preset, flags)

    return EngineClient(argv_factory, initial, sorted(presets), read_timeout)


def add_engine_flags(parser):
    parser.add_argument("--thread", type=int, help="inference threads (engine default if omitted)")
    parser.add_argument("--max-side", type=int, help="long-side budget for downscaling")
    parser.add_argument("--min-side", type=int, help="short-side floor while downscaling")
    parser.add_argument("--max-side-limit", type=int, help="hard cap of the long side")
    parser.add_argument("--upscale", type=int, choices=(0, 1), help="upscale short side to --min-side")
    parser.add_argument("--thresh", type=float, help="binarization threshold")
    parser.add_argument("--box-thresh", type=float, help="box confidence threshold")
    parser.add_argument("--unclip-ratio", type=float, help="box expansion ratio")
    parser.add_argument("--do-angle", type=int, choices=(0, 1), help="angle net")
    parser.add_argument("--most-angle", type=int, choices=(0, 1), help="most possible angle index")
    parser.add_argument("--gpu", type=int, help="vulkan gpu index, -1 disables")


def build_parser():
    parser = argparse.ArgumentParser(
        prog="ocr",
        description="Recognize text in images, or start the persistent HTTP server.",
    )
    subparsers = parser.add_subparsers(dest="command", required=True)

    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("--config", help="config file path (default: config.toml next to this script, "
                                         "else ~/.config/rapidocr/config.toml)")
    common.add_argument("--preset", help="model preset name (default from config, else 'small')")
    add_engine_flags(common)

    image_parser = subparsers.add_parser(
        "image", parents=[common],
        help="recognize text in images and print results (default command)",
        description="Recognize text in images. Prints plain text; use --json for full engine JSON.",
    )
    image_parser.add_argument("-j", "--json", action="store_true",
                              help="print full engine JSON per image (one line each) instead of plain text")
    image_parser.add_argument("--sort", default="none", choices=sorted(SORTERS),
                              help="reading-order sort applied to result blocks")
    image_parser.add_argument("images", nargs="+", help="image file paths")

    serve_parser = subparsers.add_parser(
        "serve", parents=[common],
        help="start the HTTP server (Web UI + JSON API on one port)",
        description="Persistent HTTP server: Web UI + JSON API on one port.",
    )
    serve_parser.add_argument("--host", help="bind address (default from config, else 0.0.0.0)")
    serve_parser.add_argument("--port", type=int, help="listen port (default from config, else 1538)")
    serve_parser.add_argument("--web-root", help="static files directory (default from config, else web/ next to this script)")
    return parser


def sanitize_result(result):
    meta = result.get("meta")
    if isinstance(meta, dict):
        models = meta.get("models")
        if isinstance(models, dict):
            meta["models"] = {
                key: os.path.basename(value) if isinstance(value, str) else value
                for key, value in models.items()
            }
    return result


def run_cli(args):
    cfg = load_config(args.config)
    client = make_client(cfg, args)
    sorter = SORTERS[args.sort]
    failed = False
    texts = []
    try:
        for image in args.images:
            try:
                result = client.request({"image_path": image})
            except EngineError as e:
                print(f"error: {image}: {e}", file=sys.stderr)
                failed = True
                continue
            if args.json:
                print(json.dumps(result, ensure_ascii=False))
            code = result.get("code")
            if code == 100:
                blocks = sorter(result.get("data") or [])
                text = "\n".join(block["text"] for block in blocks)
                if args.json is False:
                    texts.append(text)
            elif code == 101:
                pass
            else:
                print(f"error: {image}: [{code}] {result.get('message', 'unknown error')}",
                      file=sys.stderr)
                failed = True
    finally:
        client.stop()
    if not args.json and texts:
        print("\n\n".join(texts))
    return 1 if failed else 0


def make_handler(client):
    class Handler(BaseHTTPRequestHandler):
        def do_GET(self):
            path = urlsplit(self.path).path
            if path == "/v1/health":
                self._send_json(200, {"status": "ok"})
                return
            if path == "/v1/models":
                self._send_json(200, {
                    "object": "list",
                    "current": client.preset,
                    "data": [{"id": name, "object": "model"} for name in client.available_presets],
                })
                return
            if path.startswith("/v1/") or path.startswith("/api/"):
                self._send_json(404, {"code": 404, "message": "unknown api endpoint"})
                return
            self._serve_static(path)

        def do_HEAD(self):
            path = urlsplit(self.path).path
            if path.startswith("/v1/") or path.startswith("/api/"):
                self.send_error(404)
                return
            self._serve_static(path, body=False)

        def do_POST(self):
            path = urlsplit(self.path).path
            if path != "/v1/ocr":
                self._send_json(404, {"code": 404, "message": "unknown api endpoint"})
                return
            try:
                length = int(self.headers.get("Content-Length", ""))
            except ValueError:
                self._send_json(400, {"code": 400, "message": "missing content Length"})
                return
            if length <= 0:
                self._send_json(400, {"code": 400, "message": "empty request body"})
                return
            if length > MAX_REQUEST_BODY:
                self._send_json(413, {"code": 413, "message": "request body too large"})
                return
            try:
                request = json.loads(self.rfile.read(length))
            except json.JSONDecodeError:
                self._send_json(400, {"code": 400, "message": "invalid json"})
                return
            if not isinstance(request, dict):
                self._send_json(400, {"code": 400, "message": "request must be a json object"})
                return
            image = request.get("image")
            if not isinstance(image, str) or not image.startswith("data:") or ";base64," not in image:
                self._send_json(400, {"code": 400,
                                      "message": "image must be a base64 data URL (data:image/...;base64,...)"})
                return
            model = request.get("model")
            if model is not None and not isinstance(model, str):
                self._send_json(400, {"code": 400, "message": "model must be a string"})
                return
            payload = {"image_base64": image.split(";base64,", 1)[1]}
            for key in OVERRIDE_KEYS:
                if key in request:
                    payload[key] = request[key]
            try:
                result = client.request(payload, model=model)
            except ConfigError as e:
                self._send_json(400, {"code": 400, "message": str(e)})
                return
            except EngineError as e:
                self._send_json(500, {"code": 500, "message": str(e)})
                return
            self._send_json(HTTP_STATUS_BY_CODE.get(result.get("code"), 500),
                            sanitize_result(result))

        def _send_json(self, status, obj):
            body = json.dumps(obj, ensure_ascii=False).encode("utf-8")
            self.send_response(status)
            self.send_header("Content-Type", "application/json; charset=utf-8")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)

        def _serve_static(self, path, body=True):
            if path.endswith("/"):
                path += "index.html"
            relative = os.path.normpath(unquote(path)).lstrip("/")
            web_root = os.path.realpath(self.server.web_root)
            candidate = os.path.realpath(os.path.join(web_root, relative))
            if candidate != web_root and not candidate.startswith(web_root + os.sep):
                self.send_error(403)
                return
            if os.path.isdir(candidate):
                candidate = os.path.join(candidate, "index.html")
            if not os.path.isfile(candidate):
                self.send_error(404)
                return
            content_type = mimetypes.guess_type(candidate)[0] or "application/octet-stream"
            self.send_response(200)
            self.send_header("Content-Type", content_type)
            self.send_header("Cache-Control", "no-store")
            self.send_header("Content-Length", str(os.path.getsize(candidate)))
            self.end_headers()
            if not body:
                return
            with open(candidate, "rb") as f:
                while True:
                    chunk = f.read(65536)
                    if not chunk:
                        break
                    self.wfile.write(chunk)

    return Handler


def run_serve(args):
    cfg = load_config(args.config)
    client = make_client(cfg, args, read_timeout=SERVE_READ_TIMEOUT)
    host = args.host if args.host is not None else cfg["server"]["host"]
    port = args.port if args.port is not None else cfg["server"]["port"]
    web_root = args.web_root if args.web_root is not None else cfg["server"]["web_root"]
    if not os.path.isdir(web_root):
        raise ConfigError(f"web_root is not a directory: {web_root}")

    client.start()
    handler = make_handler(client)
    server = ThreadingHTTPServer((host, port), handler)
    server.web_root = web_root

    def on_term(_signum, _frame):
        raise SystemExit(0)

    signal.signal(signal.SIGTERM, on_term)
    print(f"ocr serve listening on http://{host}:{port} (web_root: {web_root})", file=sys.stderr)
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        pass
    finally:
        server.server_close()
        client.stop()


def main():
    argv = sys.argv[1:]
    # "image" is the default command: prepend it unless the user already
    # named a command or asked for help.
    if argv and argv[0] not in ("image", "serve", "-h", "--help"):
        argv = ["image", *argv]
    try:
        args = build_parser().parse_args(argv)
        if args.command == "serve":
            run_serve(args)
            return 0
        return run_cli(args)
    except ConfigError as e:
        print(f"error: {e}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
